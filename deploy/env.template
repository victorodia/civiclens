# CivicLens production environment — copy to .env and fill in.
# deploy/bootstrap.sh generates the secrets automatically; the entries below
# document every variable the stack requires.

# --- generated by bootstrap (do not hand-edit) ---
# POSTGRES_PASSWORD=<openssl rand -hex 24>
# JWT_SECRET_KEY=<openssl rand -hex 48>
# DATABASE_URL=postgresql+asyncpg://civiclens_user:${POSTGRES_PASSWORD}@db:5432/civiclens

# --- supplied by the operator ---
# SMTP credentials for watchdog alerting (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=

# --- Polygon anchoring (optional; wallet anchoring is disabled until set) ---
POLYGON_RPC_URL=
POLYGON_PRIVATE_KEY=
POLYGON_PUBLIC_ADDRESS=

# --- geofence advisory radius ---
GEOFENCE_RADIUS_METRES=400
